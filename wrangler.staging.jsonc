{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "focus-lab-public-staging",
  "compatibility_date": "2026-08-10",
  "main": "operations/src/public-site.ts",
  "workers_dev": true,
  "vars": {
    "PUBLIC_SITE_PRODUCTION_HOSTNAMES": "focuslabproductions.com",
    "PUBLIC_SITE_REVIEW_HOSTNAMES": "focus-lab-public-staging.freedomgeneration1111.workers.dev"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "OPERATIONS_API",
      "service": "focus-lab-api-staging"
    }
  ]
}
