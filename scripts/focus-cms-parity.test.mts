import { mkdir,mkdtemp,writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { describe,expect,it } from "vitest";
import { compareCandidateToLive,enumerateExportedRoutes,extractComparableHtml } from "./focus-cms-parity-lib.mjs";

describe("first-activation route parity",()=>{
  it("enumerates each exported public HTML route once, including the static 404",async()=>{const root=await mkdtemp(join(tmpdir(),"focus-parity-routes-"));await mkdir(join(root,"pricing"),{recursive:true});await writeFile(join(root,"index.html"),"home");await writeFile(join(root,"pricing.html"),"duplicate");await writeFile(join(root,"pricing","index.html"),"pricing");await writeFile(join(root,"404.html"),"missing");await writeFile(join(root,"_not-found.html"),"internal");const routes=await enumerateExportedRoutes(root);expect(routes.map((item)=>[item.route,item.expectedStatus])).toEqual([["/",200],["/__focus-cms-parity-not-found__",404],["/pricing/",200]]);expect(routes.find((item)=>item.route==="/pricing/")?.file).toBe(join(root,"pricing","index.html"));});
  it("ignores build-only scripts but preserves customer-visible text and external-link behavior",()=>{const first=extractComparableHtml('<html><head><script src="build-a.js"></script></head><body><footer><a href="https://example.test/review" target="_blank" rel="noopener noreferrer">Review us</a></footer></body></html>');const second=extractComparableHtml('<html><head><script src="build-b.js"></script></head><body><footer><a href="https://example.test/review" target="_blank" rel="noopener noreferrer">Review us</a></footer></body></html>');expect(first).toEqual(second);expect(first.links).toEqual([{href:"https://example.test/review",text:"Review us",target:"_blank",rel:"noopener noreferrer"}]);});
  it("reports every route with a visible text or link difference",async()=>{const root=await mkdtemp(join(tmpdir(),"focus-parity-diff-"));await writeFile(join(root,"index.html"),'<html><body><a href="https://example.test/review">Leave a review</a></body></html>');const report=await compareCandidateToLive({outputDirectory:root,liveOrigin:"https://live.example.test",fetchImpl:async()=>new Response('<html><body><p>Before</p></body></html>',{status:200})});expect(report).toMatchObject({candidateRouteCount:1,checkedRouteCount:1,differenceCount:1});expect(report.differences[0]?.fields).toMatchObject({text:{live:"Before",candidate:"Leave a review"},links:{candidateOnly:[{href:"https://example.test/review",text:"Leave a review"}]}});});
});
