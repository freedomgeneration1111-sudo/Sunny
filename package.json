{
  "name": "sunnylab-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:svg && npm run test:lib && npm run test:operations-client && npm run test:public",
    "test:public": "playwright test",
    "test:operations-client": "vitest run --config operations/vitest.config.mts",
    "public:staging:build": "NEXT_PUBLIC_INQUIRY_API_URL=https://focuslabproductions.com next build",
    "public:staging:deploy": "npm run public:staging:build && wrangler deploy --config wrangler.staging.jsonc",
    "test:lib": "vitest run --config vitest.config.mts",
    "check:svg": "node scripts/check-svg-bounds.mjs"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.23",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
